# MinGW-w64 GCC rules for the native Win32 javacall build.
include $(JAVACALL_DIR)/build/gcc/rules.gmk

ifeq ($(MINGW32_PREFIX),)
MINGW32_PREFIX=i686-w64-mingw32-
endif

CC=$(MINGW32_PREFIX)gcc
CXX=$(MINGW32_PREFIX)g++
LD=$(MINGW32_PREFIX)g++
AR=$(MINGW32_PREFIX)ar rcs
RC=$(MINGW32_PREFIX)windres

CFLAGS+=-m32 -DWIN32
CXXFLAGS+=-m32 -DWIN32
LDFLAGS+=-m32
